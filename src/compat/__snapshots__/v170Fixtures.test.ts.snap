-- -----------------------------------------------------------------------------
-- Tabla: HOTEL
-- Regla Aplicada: Paso 1: Mapeado de Entidades Fuertes
-- Justificación: Se crea la tabla 'HOTEL' para la entidad fuerte 'HOTEL'. Se mapean los atributos simples y componentes simples de compuestos.
-- -----------------------------------------------------------------------------
CREATE TABLE HOTEL (
  NOMBRE                    NUMBER(10)      NOT NULL,
  DIRECCION                 VARCHAR2(100)   NULL,
  CATEGORIA                 VARCHAR2(100)   NULL,
  CONSTRAINT PK_HOTEL PRIMARY KEY (NOMBRE)
);

-- -----------------------------------------------------------------------------
-- Tabla: SERVICIO
-- Regla Aplicada: Paso 1: Mapeado de Entidades Fuertes
-- Justificación: Se crea la tabla 'SERVICIO' para la entidad fuerte 'SERVICIO'. Se mapean los atributos simples y componentes simples de compuestos.
-- -----------------------------------------------------------------------------
CREATE TABLE SERVICIO (
  CODIGO                    NUMBER(10)      NOT NULL,
  NOMBRE                    VARCHAR2(100)   NULL,
  COSTEBASE                 VARCHAR2(100)   NULL,
  CONSTRAINT PK_SERVICIO PRIMARY KEY (CODIGO)
);

-- -----------------------------------------------------------------------------
-- Tabla: RESTAURANTE
-- Regla Aplicada: Paso 1: Mapeado de Entidades Fuertes
-- Justificación: Se crea la tabla 'RESTAURANTE' para la entidad fuerte 'RESTAURANTE'. Se mapean los atributos simples y componentes simples de compuestos.
-- -----------------------------------------------------------------------------
CREATE TABLE RESTAURANTE (
  CODIGO                    NUMBER(10)      NOT NULL,
  TIPOCOMIDA                NUMBER(10)      NULL,
  TERRAZA                   VARCHAR2(100)   NULL,
  CONSTRAINT PK_RESTAURANTE PRIMARY KEY (CODIGO),
  CONSTRAINT FK_RESTAURANTE_SERVICIO FOREIGN KEY (CODIGO) REFERENCES SERVICIO (CODIGO) ON DELETE CASCADE
);

-- -----------------------------------------------------------------------------
-- Tabla: SPA
-- Regla Aplicada: Paso 1: Mapeado de Entidades Fuertes
-- Justificación: Se crea la tabla 'SPA' para la entidad fuerte 'SPA'. Se mapean los atributos simples y componentes simples de compuestos.
-- -----------------------------------------------------------------------------
CREATE TABLE SPA (
  CODIGO                    NUMBER(10)      NOT NULL,
  MASAJES                   VARCHAR2(100)   NULL,
  CONSTRAINT PK_SPA PRIMARY KEY (CODIGO),
  CONSTRAINT FK_SPA_SERVICIO FOREIGN KEY (CODIGO) REFERENCES SERVICIO (CODIGO) ON DELETE CASCADE
);

-- -----------------------------------------------------------------------------
-- Tabla: SALON_EVENTOS
-- Regla Aplicada: Paso 1: Mapeado de Entidades Fuertes
-- Justificación: Se crea la tabla 'SALON_EVENTOS' para la entidad fuerte 'SALON_EVENTOS'. Se mapean los atributos simples y componentes simples de compuestos.
-- -----------------------------------------------------------------------------
CREATE TABLE SALON_EVENTOS (
  CODIGO                    NUMBER(10)      NOT NULL,
  CAPACIDAD                 NUMBER(10)      NULL,
  EQUIPOAV                  VARCHAR2(100)   NULL,
  CONSTRAINT PK_SALON_EVENTOS PRIMARY KEY (CODIGO),
  CONSTRAINT FK_SALON_EVENTOS_SERVICIO FOREIGN KEY (CODIGO) REFERENCES SERVICIO (CODIGO) ON DELETE CASCADE
);

-- -----------------------------------------------------------------------------
-- Tabla: EMPLEADO
-- Regla Aplicada: Paso 1: Mapeado de Entidades Fuertes
-- Justificación: Se crea la tabla 'EMPLEADO' para la entidad fuerte 'EMPLEADO'. Se mapean los atributos simples y componentes simples de compuestos.
-- -----------------------------------------------------------------------------
CREATE TABLE EMPLEADO (
  DNI                       NUMBER(10)      NOT NULL,
  NOMBRE                    VARCHAR2(100)   NULL,
  SALARIO                   NUMBER(12, 2)   NULL,
  ANTIGUEDAD                VARCHAR2(100)   NULL,
  HOTEL_NOMBRE              NUMBER(10)      NULL,
  CONSTRAINT PK_EMPLEADO PRIMARY KEY (DNI),
  CONSTRAINT FK_EMPLEADO_HOTEL FOREIGN KEY (HOTEL_NOMBRE) REFERENCES HOTEL (NOMBRE) ON DELETE SET NULL
);

-- -----------------------------------------------------------------------------
-- Tabla: CLIENTE
-- Regla Aplicada: Paso 1: Mapeado de Entidades Fuertes
-- Justificación: Se crea la tabla 'CLIENTE' para la entidad fuerte 'CLIENTE'. Se mapean los atributos simples y componentes simples de compuestos.
-- -----------------------------------------------------------------------------
CREATE TABLE CLIENTE (
  DNI                       NUMBER(10)      NOT NULL,
  NOMBRE                    VARCHAR2(100)   NULL,
  CONSTRAINT PK_CLIENTE PRIMARY KEY (DNI)
);

-- -----------------------------------------------------------------------------
-- Tabla: HABITACION
-- Regla Aplicada: Paso 2: Mapeado de Entidades Débiles
-- Justificación: Se crea la tabla 'HABITACION' para la entidad débil 'HABITACION'. Incluye la PK de la entidad propietaria como FK y forma su PK compuesta con su clave parcial.
-- -----------------------------------------------------------------------------
CREATE TABLE HABITACION (
  HOTEL_NOMBRE              NUMBER(10)      NOT NULL,
  NUMPUERTA                 NUMBER(10)      NOT NULL,
  PISO                      VARCHAR2(100)   NULL,
  TIPO                      VARCHAR2(100)   NULL,
  CONSTRAINT PK_HABITACION PRIMARY KEY (HOTEL_NOMBRE, NUMPUERTA),
  CONSTRAINT FK_HABITACION_HOTEL FOREIGN KEY (HOTEL_NOMBRE) REFERENCES HOTEL (NOMBRE) ON DELETE CASCADE
);

-- -----------------------------------------------------------------------------
-- Tabla: OFRECE
-- Regla Aplicada: Paso 5: Mapeado de Relaciones M:N Binarias
-- Justificación: Se crea la tabla puente 'OFRECE' para representar la relación muchos-a-muchos. Su PK es la unión de las FKs de ambas entidades.
-- -----------------------------------------------------------------------------
CREATE TABLE OFRECE (
  HOTEL_NOMBRE              NUMBER(10)      NOT NULL,
  SERVICIO_CODIGO           NUMBER(10)      NOT NULL,
  CONSTRAINT PK_OFRECE PRIMARY KEY (HOTEL_NOMBRE, SERVICIO_CODIGO),
  CONSTRAINT FK_OFRECE_HOTEL FOREIGN KEY (HOTEL_NOMBRE) REFERENCES HOTEL (NOMBRE),
  CONSTRAINT FK_OFRECE_SERVICIO FOREIGN KEY (SERVICIO_CODIGO) REFERENCES SERVICIO (CODIGO)
);

-- -----------------------------------------------------------------------------
-- Tabla: RESERVA
-- Regla Aplicada: Paso 7: Mapeado de Relaciones N-arias (n > 2)
-- Justificación: Se crea la tabla de relación 'RESERVA' para representar la relación n-aria entre 3 entidades. Su PK es la combinación de las FKs de las entidades sin restricción de cardinalidad 1.
-- -----------------------------------------------------------------------------
CREATE TABLE RESERVA (
  SALON_EVENTOS_CODIGO      NUMBER(10)      NOT NULL,
  EMPLEADO_DNI              NUMBER(10)      NOT NULL,
  CLIENTE_DNI               NUMBER(10)      NOT NULL,
  PRECIOFINAL               NUMBER(12, 2)   NULL,
  FECHA                     DATE            NULL,
  CONSTRAINT PK_RESERVA PRIMARY KEY (SALON_EVENTOS_CODIGO, CLIENTE_DNI),
  CONSTRAINT FK_RESERVA_SALON_EVENTOS FOREIGN KEY (SALON_EVENTOS_CODIGO) REFERENCES SALON_EVENTOS (CODIGO),
  CONSTRAINT FK_RESERVA_EMPLEADO FOREIGN KEY (EMPLEADO_DNI) REFERENCES EMPLEADO (DNI),
  CONSTRAINT FK_RESERVA_CLIENTE FOREIGN KEY (CLIENTE_DNI) REFERENCES CLIENTE (DNI)
);
