{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dbv-eer-studio",
  "version": "1.6.0",
  "identifier": "com.davidbuenov.dbveerstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "dbv-eer-studio — Suite Docente de Bases de Datos",
        "width": 1280,
        "height": 800,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "David Bueno Vallejo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
